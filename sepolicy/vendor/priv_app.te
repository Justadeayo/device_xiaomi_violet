dontaudit priv_app bt_firmware_file:filesystem getattr;
dontaudit priv_app firmware_file:filesystem getattr;
dontaudit priv_app mnt_vendor_file:dir search;

# Charge limit / bypass (XiaomiParts): battery/charging_enabled and dc/input_suspend
allow priv_app vendor_sysfs_battery_supply:dir r_dir_perms;
allow priv_app vendor_sysfs_battery_supply:file rw_file_perms;
